"""
Script para inicializar o banco de dados e criar o primeiro usuário admin.

Uso:
    python init_db.py

Cria o banco (database.db) e cadastra um usuário administrador.
Rode apenas uma vez, ou quando quiser resetar o banco.
"""

from app import app
from models import db, Usuario, Aula

DADOS_EXEMPLO = [
    ("Segunda-feira", "manha", "2401", "Ana Souza", "Técnico em Informática", "Lab 01"),
    ("Segunda-feira", "manha", "2415", "Carlos Lima", "Programação Web", "Lab 03"),
    ("Segunda-feira", "tarde", "2408", "Mariana Costa", "Design Gráfico", "Sala 12"),
    ("Segunda-feira", "noite", "2422", "Eduardo Barreto", "Lógica de Programação", "Lab 02"),
    ("Segunda-feira", "noite", "2430", "Fernanda Reis", "Banco de Dados", "Lab 04"),
    ("Terça-feira", "manha", "2403", "Roberto Silva", "Redes de Computadores", "Lab 05"),
    ("Quarta-feira", "noite", "2422", "Eduardo Barreto", "Lógica de Programação", "Lab 02"),
]


def init():
    with app.app_context():
        # Cria todas as tabelas
        db.drop_all()
        db.create_all()

        # Cria usuário admin
        admin = Usuario(nome="Administrador", email="admin@senac.com")
        admin.set_senha("senac2026")
        db.session.add(admin)

        # Insere dados de exemplo
        for dia, turno, turma, prof, curso, sala in DADOS_EXEMPLO:
            aula = Aula(
                dia_semana=dia,
                turno=turno,
                turma=turma,
                professor=prof,
                curso=curso,
                sala=sala,
            )
            db.session.add(aula)

        db.session.commit()

        print("=" * 50)
        print("  Banco de dados criado com sucesso!")
        print("=" * 50)
        print()
        print("  Usuário admin criado:")
        print("    E-mail: admin@senac.com")
        print("    Senha:  senac2026")
        print()
        print("  Dados de exemplo inseridos (7 aulas).")
        print()
        print("  Para rodar o servidor:")
        print("    python app.py")
        print()
        print("  Acesse: http://localhost:5000")
        print("=" * 50)


if __name__ == "__main__":
    init()